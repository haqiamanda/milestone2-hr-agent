API_PORT=8000
STREAMLIT_PORT=8501
MODEL_MODE=live
MAX_AGENT_TURNS=4
MAX_TOOL_CALLS=6
MAX_OUTPUT_TOKENS=700
MODEL_TIMEOUT_SECONDS=30
PROPOSAL_TTL_MINUTES=15
RETRIEVAL_CACHE_TTL_SECONDS=900
# Configure rates only when supplied by the instructor/provider.
INPUT_COST_PER_1M=
OUTPUT_COST_PER_1M=
